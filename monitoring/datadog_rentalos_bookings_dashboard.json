{
  "title": "RentalOS Booking Operations",
  "description": "Operational dashboard for offline RentalOS booking activity in gopanda-backend. Tracks booking creation, booking lifecycle actions, offline payment records, latency, and errors for /api/v1/rentalos booking endpoints only.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "notify_list": [],
  "pause_auto_refresh": false,
  "tags": [
    "team:gopanda",
    "ai:created_with_ai"
  ],
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [
        "production"
      ],
      "default": "production"
    }
  ],
  "widgets": [
    {
      "id": 1000001,
      "definition": {
        "title": "Overview",
        "background_color": "vivid_blue",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 2000001,
            "definition": {
              "type": "note",
              "content": "**RentalOS Booking Operations**\nOffline rental desk bookings only.\n\nCore create resource:\n`POST /api/v1/rentalos/bookings`\n\n[View in APM](/apm/entity/service/gopanda-backend)",
              "background_color": "blue",
              "font_size": "14",
              "text_align": "left",
              "vertical_align": "center",
              "show_tick": false,
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 3,
              "height": 2
            }
          },
          {
            "id": 2000002,
            "definition": {
              "title": "Booking Create Rate",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "query1",
                      "service": "gopanda-backend",
                      "stat": "hits_per_second",
                      "query_filter": "$env resource_name:\"POST /api/v1/rentalos/bookings\"",
                      "span_kind": "server"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1",
                      "alias": "Bookings/sec"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 3
            },
            "layout": {
              "x": 3,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "id": 2000003,
            "definition": {
              "title": "Create Error Rate",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "query1",
                      "service": "gopanda-backend",
                      "stat": "error_rate",
                      "query_filter": "$env resource_name:\"POST /api/v1/rentalos/bookings\"",
                      "span_kind": "server"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1 * 100",
                      "alias": "Error %",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      }
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 5,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">",
                      "value": 1,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 2
            },
            "layout": {
              "x": 5,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "id": 2000004,
            "definition": {
              "title": "Create P95 Latency",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "query1",
                      "service": "gopanda-backend",
                      "stat": "latency_p95",
                      "query_filter": "$env resource_name:\"POST /api/v1/rentalos/bookings\"",
                      "span_kind": "server"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "second"
                        }
                      }
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 1,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">",
                      "value": 0.5,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 2
            },
            "layout": {
              "x": 7,
              "y": 0,
              "width": 2,
              "height": 2
            }
          },
          {
            "id": 2000005,
            "definition": {
              "title": "Booking Endpoint Traffic",
              "type": "query_value",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "query1",
                      "service": "gopanda-backend",
                      "stat": "hits_per_second",
                      "query_filter": "$env resource_name:*rentalos/bookings*",
                      "span_kind": "server"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1",
                      "alias": "Requests/sec"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">=",
                      "value": 0,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ],
              "autoscale": true,
              "precision": 3
            },
            "layout": {
              "x": 9,
              "y": 0,
              "width": 3,
              "height": 2
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 3
      }
    },
    {
      "id": 1000002,
      "definition": {
        "title": "Booking Activity",
        "background_color": "vivid_green",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 3000001,
            "definition": {
              "title": "Bookings Created",
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "query1",
                      "service": "gopanda-backend",
                      "stat": "hits_per_second",
                      "query_filter": "$env resource_name:\"POST /api/v1/rentalos/bookings\"",
                      "span_kind": "server"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1",
                      "alias": "Booking creates/sec"
                    }
                  ],
                  "style": {
                    "palette": "green"
                  },
                  "display_type": "bars"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "id": 3000002,
            "definition": {
              "title": "Booking Lifecycle Actions",
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "query1",
                      "service": "gopanda-backend",
                      "stat": "hits_per_second",
                      "query_filter": "$env resource_name:\"POST /api/v1/rentalos/bookings/{booking_id}/complete\"",
                      "span_kind": "server"
                    },
                    {
                      "data_source": "apm_metrics",
                      "name": "query2",
                      "service": "gopanda-backend",
                      "stat": "hits_per_second",
                      "query_filter": "$env resource_name:\"POST /api/v1/rentalos/bookings/{booking_id}/cancel\"",
                      "span_kind": "server"
                    },
                    {
                      "data_source": "apm_metrics",
                      "name": "query3",
                      "service": "gopanda-backend",
                      "stat": "hits_per_second",
                      "query_filter": "$env resource_name:\"POST /api/v1/rentalos/bookings/{booking_id}/payments\"",
                      "span_kind": "server"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1",
                      "alias": "Completed/sec"
                    },
                    {
                      "formula": "query2",
                      "alias": "Cancelled/sec"
                    },
                    {
                      "formula": "query3",
                      "alias": "Payments recorded/sec"
                    }
                  ],
                  "style": {
                    "palette": "cool"
                  },
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 3,
        "width": 12,
        "height": 4
      }
    },
    {
      "id": 1000003,
      "definition": {
        "title": "Reliability",
        "background_color": "vivid_orange",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 4000001,
            "definition": {
              "title": "Booking Endpoint Errors",
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "query1",
                      "service": "gopanda-backend",
                      "stat": "error_rate",
                      "query_filter": "$env resource_name:*rentalos/bookings*",
                      "span_kind": "server"
                    },
                    {
                      "data_source": "apm_metrics",
                      "name": "query2",
                      "service": "gopanda-backend",
                      "stat": "errors_per_second",
                      "query_filter": "$env resource_name:*rentalos/bookings*",
                      "span_kind": "server"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1 * 100",
                      "alias": "Error Rate %"
                    },
                    {
                      "formula": "query2",
                      "alias": "Errors/sec"
                    }
                  ],
                  "style": {
                    "palette": "warm"
                  },
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 3
            }
          },
          {
            "id": 4000002,
            "definition": {
              "title": "Booking Endpoint Latency",
              "type": "timeseries",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "query1",
                      "service": "gopanda-backend",
                      "stat": "latency_p50",
                      "query_filter": "$env resource_name:*rentalos/bookings*",
                      "span_kind": "server"
                    },
                    {
                      "data_source": "apm_metrics",
                      "name": "query2",
                      "service": "gopanda-backend",
                      "stat": "latency_p95",
                      "query_filter": "$env resource_name:*rentalos/bookings*",
                      "span_kind": "server"
                    },
                    {
                      "data_source": "apm_metrics",
                      "name": "query3",
                      "service": "gopanda-backend",
                      "stat": "latency_p99",
                      "query_filter": "$env resource_name:*rentalos/bookings*",
                      "span_kind": "server"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "query1",
                      "alias": "P50"
                    },
                    {
                      "formula": "query2",
                      "alias": "P95"
                    },
                    {
                      "formula": "query3",
                      "alias": "P99"
                    }
                  ],
                  "style": {
                    "palette": "cool"
                  },
                  "display_type": "line"
                }
              ]
            },
            "layout": {
              "x": 6,
              "y": 0,
              "width": 6,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 7,
        "width": 12,
        "height": 4
      }
    },
    {
      "id": 1000004,
      "definition": {
        "title": "Endpoint Breakdown",
        "background_color": "vivid_purple",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 5000001,
            "definition": {
              "title": "RentalOS Booking Endpoints",
              "type": "query_table",
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "apm_metrics",
                      "name": "query1",
                      "service": "gopanda-backend",
                      "stat": "hits_per_second",
                      "query_filter": "$env resource_name:*rentalos/bookings*",
                      "span_kind": "server",
                      "group_by": [
                        "resource_name"
                      ]
                    },
                    {
                      "data_source": "apm_metrics",
                      "name": "query2",
                      "service": "gopanda-backend",
                      "stat": "latency_p95",
                      "query_filter": "$env resource_name:*rentalos/bookings*",
                      "span_kind": "server",
                      "group_by": [
                        "resource_name"
                      ]
                    },
                    {
                      "data_source": "apm_metrics",
                      "name": "query3",
                      "service": "gopanda-backend",
                      "stat": "error_rate",
                      "query_filter": "$env resource_name:*rentalos/bookings*",
                      "span_kind": "server",
                      "group_by": [
                        "resource_name"
                      ]
                    },
                    {
                      "data_source": "apm_metrics",
                      "name": "query4",
                      "service": "gopanda-backend",
                      "stat": "errors_per_second",
                      "query_filter": "$env resource_name:*rentalos/bookings*",
                      "span_kind": "server",
                      "group_by": [
                        "resource_name"
                      ]
                    }
                  ],
                  "sort": {
                    "count": 20,
                    "order_by": [
                      {
                        "type": "formula",
                        "index": 0,
                        "order": "desc"
                      }
                    ]
                  },
                  "formulas": [
                    {
                      "formula": "query1",
                      "alias": "Req/s",
                      "cell_display_mode": "bar"
                    },
                    {
                      "formula": "query2",
                      "alias": "P95 Latency",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "second"
                        }
                      }
                    },
                    {
                      "formula": "query3 * 100",
                      "alias": "Error Rate %",
                      "number_format": {
                        "unit": {
                          "type": "canonical_unit",
                          "unit_name": "percent"
                        }
                      },
                      "conditional_formats": [
                        {
                          "comparator": ">",
                          "value": 5,
                          "palette": "white_on_red"
                        },
                        {
                          "comparator": ">",
                          "value": 1,
                          "palette": "white_on_yellow"
                        },
                        {
                          "comparator": ">=",
                          "value": 0,
                          "palette": "white_on_green"
                        }
                      ]
                    },
                    {
                      "formula": "query4",
                      "alias": "Errors/sec"
                    }
                  ]
                }
              ]
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 5
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 11,
        "width": 12,
        "height": 6
      }
    }
  ]
